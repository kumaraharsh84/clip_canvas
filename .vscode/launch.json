{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ClipCanvas",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": [".", "--dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": [".", "--inspect=5858"],
      "cwd": "${workspaceFolder}",
      "port": 5858,
      "console": "integratedTerminal"
    }
  ]
}
