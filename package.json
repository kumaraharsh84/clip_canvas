{
  "name": "clipcanvas",
  "version": "2.0.0",
  "description": "Floating clipboard manager with canvas UI",
  "author": "kumar",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "node scratch/verify-classify.js && node scratch/verify-timecanvas-2d.js",
    "bundle": "node src/renderer/canvas/build.js src/renderer/timecanvas.bundle.js && node src/renderer/canvas/build.js demo/timecanvas.bundle.js",
    "demo": "node demo/serve.js",
    "verify:app": "electron scratch/verify-app.js",
    "screenshots": "electron scratch/capture-demo.js",
    "test:db": "electron scratch/verify-db.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.clipcanvas.app",
    "productName": "ClipCanvas",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "UNLICENSED"
}
