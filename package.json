{
  "name": "clipcanvas",
  "version": "2.0.0",
  "private": true,
  "description": "Your whole clipboard history on one zoomable calendar canvas, for Windows",
  "keywords": [
    "clipboard",
    "clipboard-manager",
    "clipboard-history",
    "electron",
    "canvas",
    "timeline",
    "windows"
  ],
  "homepage": "https://github.com/kumaraharsh84/clip_canvas#readme",
  "bugs": {
    "url": "https://github.com/kumaraharsh84/clip_canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kumaraharsh84/clip_canvas.git"
  },
  "license": "UNLICENSED",
  "author": "kumar",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "node test/verify-classify.js && node test/verify-timecanvas-2d.js && node test/verify-clipwatch.js && node test/verify-asset-protocol.js",
    "bundle": "node src/renderer/canvas/build.js src/renderer/timecanvas.bundle.js && node src/renderer/canvas/build.js demo/timecanvas.bundle.js",
    "demo": "node demo/serve.js",
    "verify:app": "electron test/verify-app.js",
    "screenshots": "electron test/capture-demo.js",
    "test:db": "electron test/verify-db.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "build": {
    "appId": "com.clipcanvas.app",
    "productName": "ClipCanvas",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "copyright": "Copyright © 2026 kumar",
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}
